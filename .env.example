# GMOコイン Public API を使う既定構成では、設定は一切不要です。
# 以下は別のデータソースを使う場合のみ設定してください。

# GMOのAPIがブラウザから直接呼べない(CORS)場合の中継先。gmo-proxy/ 参照。
# EXPO_PUBLIC_GMO_PROXY_URL=https://your-worker.workers.dev

# OANDA証券を使う場合(GOLD会員+25万円+プロコースが必要)。oanda-proxy/ 参照。
# EXPO_PUBLIC_OANDA_PROXY_URL=https://your-worker.workers.dev

# Twelve Data(旧構成)を使う場合
# EXPO_PUBLIC_USE_TWELVEDATA=1
# EXPO_PUBLIC_TWELVEDATA_API_KEY=your_key_here
